# Generate a random private value of at least 32 characters. Never commit it.
COSMETICS_ADMIN_TOKEN=
PORT=8787
# Premium authentication is enabled by default. Setting this to false disables
# player login entirely; it never enables authentication by UUID or nickname.
COSMETICS_ENABLE_PREMIUM=true
# Optional email delivery for password recovery. Without these values, an
# administrator can still issue a one-time code from the Accounts panel.
COSMETICS_RESEND_API_KEY=
COSMETICS_EMAIL_FROM=MineLatino <cuentas@example.com>

# Optional AI assistant. Keep these values only in the private backend.
AI_SOURCE=minelatino-web
MINELATINO_ASSISTANT_URL=https://minelatino.net
# Sólo para AI_SOURCE=direct:
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_API_STYLE=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_CONTEXT_MESSAGES=30
AI_DAILY_REQUEST_LIMIT=100
